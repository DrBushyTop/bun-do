<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Token minting is never compiled into deployable Release artifacts. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Identity/Development/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../contracts/ai/extraction.schema.json" LogicalName="BunDo.CleanupSchema" />
    <EmbeddedResource Include="../../contracts/ai/capture.schema.json" LogicalName="BunDo.CaptureSchema" />
    <EmbeddedResource Include="../../contracts/ai/adventure-plan.schema.json" LogicalName="BunDo.AdventurePlanSchema" />
    <EmbeddedResource Include="../../contracts/ai/adventure.schema.json" LogicalName="BunDo.AdventureSchema" />
    <EmbeddedResource Include="../../contracts/ai/split.schema.json" LogicalName="BunDo.SplitSchema" />
    <ProjectReference Include="../BunDo.Domain/BunDo.Domain.csproj" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.63.0" />
    <!-- Cosmos system documents still require this even with our System.Text.Json serializer. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.28.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.9.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.OpenTelemetry" Version="1.2.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
  </ItemGroup>

</Project>
